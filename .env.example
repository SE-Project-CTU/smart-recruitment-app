# ================================================================
# cd Backend
# .env.example — Sao chép thành .env rồi điền giá trị thực
# cp .env.example .env        (Linux / macOS / Git Bash)
# copy .env.example .env      (Windows CMD)
#
# File .env KHÔNG được commit lên Git.
# ================================================================

# --- PostgreSQL ---
POSTGRES_DB=smarthire_dev
POSTGRES_USER=smarthire_app
POSTGRES_PASSWORD=<your_password_here>          # <<< đổi thành mật khẩu thực

# --- Cloudinary ---
Cloudinary__CloudName=<your_cloudinary_cloud_name>
Cloudinary__ApiKey=<your_cloudinary_api_key>
Cloudinary__ApiSecret=<your_cloudinary_api_secret>

# --- JWT ---
Jwt__SigningKey=<your_secret_key_here>

# --- CORS ---
# Ngăn cách các origin bằng dấu phẩy, không có khoảng trắng
Cors__AllowedOrigins=first_origin,second_origin,...   
# ví dụ: http://localhost:5173,https://smart-recruitment-app.vercel.app 

# --- SignalR Real-time Notifications ---
SignalR__Enabled=true

# --- Admin User ---
ADMIN_EMAIL='<your_admin_email_here>'
ADMIN_PASSWORD='<your_admin_password_here>'
ADMIN_FULL_NAME='<your_admin_full_name_here>'

# --- Google Gemini AI ---
Gemini__ApiKey=<your_gemini_api_key_here>
Gemini__Model=gemini-3.5-flash-lite
Gemini__EmbeddingModel=gemini-embedding-001

# --- Redis (Distributed Cache & Rate Limiting) ---
# Kết nối Redis dùng cho Rate Limiter và Distributed Memory Cache
Redis__Enabled=true
Redis__Host=localhost
Redis__Port=6379
Redis__Password=<your_redis_password_here>
Redis__ConnectionString=localhost:6379,password=<your_redis_password_here>,abortConnect=false,ssl=false

# ================================================================
# --- Firebase Authentication (Google Sign-In) ---
# ================================================================
#
# Firebase Admin SDK (Backend — đặt trong Backend/.env):
#    - Tải Private Key JSON tại: Firebase Console -> Project Settings -> Service accounts -> Generate new private key
#    - Bóc tách các trường từ file JSON vào các biến Firebase__* bên dưới (KHÔNG lưu file JSON hay secret thật lên Git):
Firebase__Type=service_account
Firebase__ProjectId=<your_project_id>
Firebase__PrivateKeyId=<your_private_key_id>
Firebase__PrivateKey="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
Firebase__ClientEmail=<your_client_email>
Firebase__ClientId=<your_client_id>
Firebase__AuthUri=https://accounts.google.com/o/oauth2/auth
Firebase__TokenUri=https://oauth2.googleapis.com/token
Firebase__AuthProviderX509CertUrl=https://www.googleapis.com/oauth2/v1/certs
Firebase__ClientX509CertUrl=<your_client_x509_cert_url>
Firebase__UniverseDomain=googleapis.com



# --- Port expose ra máy host (tuỳ chọn, có thể giữ nguyên default) ---
# API_HOST_PORT=5190                 # Swagger: http://localhost:5190/swagger
#                                    # Hangfire: http://localhost:5190/hangfire
# FRONTEND_HOST_PORT=5173            # Frontend: http://localhost:5173

# --- URL mà trình duyệt dùng để gọi API (build-time arg cho Frontend) ---
# Phải là địa chỉ máy host, không phải tên service Docker
VITE_API_BASE_URL=http://localhost:5190/api/v1/
# Firebase Web SDK (Frontend):
#    - Nếu chạy local Vite: đặt các biến VITE_FIREBASE_* vào Frontend/.env
#    - Nếu chạy Docker Compose: đặt thêm vào root .env để truyền build args
#    - Lấy giá trị tại: Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=<your_firebase_api_key>
VITE_FIREBASE_AUTH_DOMAIN=<your_project_id>.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=<your_project_id>
VITE_FIREBASE_STORAGE_BUCKET=<your_project_id>.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=<your_messaging_sender_id>
VITE_FIREBASE_APP_ID=<your_firebase_app_id>
VITE_FIREBASE_MEASUREMENT_ID=<your_measurement_id>